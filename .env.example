# Configuración básica. Todo lo demás (Asterisk, base de datos, grabaciones...) se configura desde la GUI.
PORT=3000
HOST=0.0.0.0
# Carpeta donde la GUI guarda su propia configuración (SQLite)
DATA_DIR=./data
# Clave para firmar sesiones y cifrar contraseñas guardadas. Si se omite, se genera en DATA_DIR/secret.key
APP_SECRET=
# Usuario inicial (solo se usa la primera vez, cuando no existen usuarios). Si ADMIN_PASSWORD se omite, se genera y se imprime en consola.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Poner en true si se sirve detrás de HTTPS (cookie Secure) / confiar en proxy inverso
COOKIE_SECURE=false
TRUST_PROXY=false
